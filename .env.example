# Copy to .env for local use (`npm run dev` reads it), or set these in your
# hosting provider's dashboard. Only the first block is required to go live.

# ---- Required in production ----------------------------------------------------
# Public address of the site, no trailing slash
BASE_URL=https://yourdomain.com
# Any long random string, e.g. the output of: openssl rand -hex 32
SESSION_SECRET=
# Who can open /admin and receives the weekly business digest (comma-separated)
ADMIN_EMAILS=you@yourdomain.com
# Shown on the site; replies to emails go here
SUPPORT_EMAIL=support@yourdomain.com

# ---- Email (Resend recommended: https://resend.com) --------------------------------
# resend | postmark | log  (log prints emails to the console instead of sending)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Sitewarden <alerts@yourdomain.com>

# ---- Stripe (run `npm run stripe:setup` to generate these values) ------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
STRIPE_PORTAL_CONFIGURATION=
# 1 = let Stripe Tax add VAT / sales tax at checkout (set up Stripe Tax first)
STRIPE_AUTOMATIC_TAX=0
TRIAL_DAYS=14

# ---- Branding & legal --------------------------------------------------------------
BRAND_NAME=Sitewarden
# Legal entity shown in the footer, terms and emails
COMPANY_NAME=Sitewarden LLC
# Postal address (required in marketing emails by CAN-SPAM)
COMPANY_ADDRESS=
GOVERNING_LAW=the State of Delaware, USA

# ---- Pricing in USD (must match Stripe; re-run stripe:setup after changing) --------
PRICE_PRO_MONTHLY=9
PRICE_AGENCY_MONTHLY=39
# Yearly prices default to 10x monthly (two months free)
# PRICE_PRO_YEARLY=90
# PRICE_AGENCY_YEARLY=390
# FREE_MONITORS=5
# PRO_MONITORS=30
# AGENCY_MONITORS=200

# ---- Optional ------------------------------------------------------------------------
# Privacy-friendly analytics via plausible.io (set to your domain)
PLAUSIBLE_DOMAIN=
PORT=3000
DATABASE_PATH=./data/sitewarden.db
# Daily database snapshots, kept for 7 days
BACKUP_DIR=./data/backups
# Set to 1 when running behind Fly, Render, Cloudflare or nginx
TRUST_PROXY=0
# CHECK_CONCURRENCY=40
# Failed checks in a row before an alert is sent
# CONFIRM_FAILURES=2
# Never enable in production
# ALLOW_PRIVATE_TARGETS=0
